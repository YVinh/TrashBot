# Claude API (get from https://console.anthropic.com/) — shared by all three bots
CLAUDE_API_KEY=your_claude_api_key_here

# Marc's X API credentials (get from https://developer.twitter.com/en/portal/dashboard)
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Telegram bot (for bot.py — see README "Telegram bot" section)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated chat_ids allowed to submit photos. Message the bot with /start to see yours.
ALLOWED_TELEGRAM_CHAT_IDS=your_chat_id_here
# Comma-separated Telegram user_ids (not chat_ids) allowed to approve/discard drafts and
# have their photo captions passed to the agent. Anyone else in an allowed chat can still
# submit photos, but can't approve anything and their captions are dropped before the LLM
# sees them. Leave empty to allow anyone in an allowed chat to approve (not recommended
# once you've added other people to the chat).
OWNER_TELEGRAM_USER_IDS=your_user_id_here

# Giselle's X account — separate developer app, same steps as Marc's above
GISELLE_X_API_KEY=your_giselle_x_api_key_here
GISELLE_X_API_SECRET=your_giselle_x_api_secret_here
GISELLE_X_ACCESS_TOKEN=your_giselle_x_access_token_here
GISELLE_X_ACCESS_TOKEN_SECRET=your_giselle_x_access_token_secret_here

# Yousuf's X account — separate developer app, same steps as Marc's above
YOUSUF_X_API_KEY=your_yousuf_x_api_key_here
YOUSUF_X_API_SECRET=your_yousuf_x_api_secret_here
YOUSUF_X_ACCESS_TOKEN=your_yousuf_x_access_token_here
YOUSUF_X_ACCESS_TOKEN_SECRET=your_yousuf_x_access_token_secret_here

# Public site (site/ → "Trashbot Village"). The bot writes every post it makes to
# feed.json there and then runs FEED_PUBLISH_CMD to ship the folder. Leave both
# unset to only write the files locally.
# Where the deployable copy lives — on the server, a clone of the site repo, so the
# bot's feed commits don't land in this code repo.
FEED_SITE_DIR=
# Run inside FEED_SITE_DIR after each post. For a git-backed host (Cloudflare Pages,
# GitHub Pages, Netlify):
#   git add -A && git -c user.name=trashbot -c user.email=trashbot@localhost commit -qm "Feed update" && git push -q
# For a plain web host: rsync -az --delete ./ user@host:/var/www/trashbot/
FEED_PUBLISH_CMD=
# Read public replies + like/repost/impression counts from X this often (hours).
# 0 = never. Each pass is ~2 read requests per thread under 7 days old, billed
# against Marc's X API credits. Replies are screened by Claude before they appear.
FEED_POLL_HOURS=0
# Salt for the anonymous visitor numbers (any random string; changing it renumbers everyone).
FEED_VISITOR_SALT=

# FixMyStreet Brussels (fixmystreet.brussels) — a real report, filed in YOUR name, for
# photos you send the bot in a private chat (never from the group) and approve with the
# "Post + report" button. The photo must carry GPS (send it as a File).
FMS_ENABLED=1
FMS_REPORTER_NAME=Your Name
FMS_REPORTER_EMAIL=you@example.com
FMS_REPORTER_PHONE=
# 1 = analyse the photo and resolve the address but write NOTHING to FixMyStreet (shows what
# would be filed, for a first test), 0 = file for real
FMS_DRY_RUN=0
# Re-read the status of open reports from fixmystreet.brussels this often (free, no auth)
FMS_STATUS_POLL_HOURS=12
